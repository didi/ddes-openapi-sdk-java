<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.xiaoju.sdk</groupId>
    <artifactId>ddes-openapi-sdk-java</artifactId>
    <version>1.0.1</version>
  </parent>

  <artifactId>integration</artifactId>
  <name>integration</name>
  <description>真实脱敏流量回放验证模块（独立子模块，仅 integration profile 激活时构建）</description>

  <properties>
    <java.version>1.8</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spock.version>1.3-groovy-2.5</spock.version>
    <cglib-nodep.version>3.3.0</cglib-nodep.version>
    <okhttp.version>3.14.9</okhttp.version>
  </properties>

  <dependencies>
    <!-- 被测 SDK（compile scope，回放调用其真实方法） -->
    <dependency>
      <groupId>com.xiaojukeji.esapi</groupId>
      <artifactId>ddes-open-sdk</artifactId>
      <version>1.1.0</version>
    </dependency>

    <!-- Spock + Groovy 测试框架 -->
    <dependency>
      <groupId>org.spockframework</groupId>
      <artifactId>spock-core</artifactId>
      <version>${spock.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.junit.platform</groupId>
          <artifactId>junit-platform-engine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>cglib</groupId>
      <artifactId>cglib-nodep</artifactId>
      <version>${cglib-nodep.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- JUnit 4 for Spock -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest-core</artifactId>
      <version>2.2</version>
      <scope>test</scope>
    </dependency>

    <!-- OkHttp + MockWebServer（动态 mock 回放） -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>${okhttp.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver</artifactId>
      <version>${okhttp.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Spring Web：SDK 将 spring-web 设为 provided（依赖方自行提供），
         且 LocalTokenHolder 静态引用 org.springframework.util.StringUtils，
         运行时缺类会 NoClassDefFoundError。回放虽用 OkHttpTransport，仍需提供 Spring。 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <version>5.2.12.RELEASE</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- GMavenPlus 编译 Groovy 测试代码 -->
      <plugin>
        <groupId>org.codehaus.gmavenplus</groupId>
        <artifactId>gmavenplus-plugin</artifactId>
        <version>1.13.1</version>
        <configuration>
          <targetBytecode>1.8</targetBytecode>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>addTestSources</goal>
              <goal>compileTests</goal>
            </goals>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.codehaus.groovy</groupId>
            <artifactId>groovy-all</artifactId>
            <version>2.5.14</version>
            <type>pom</type>
          </dependency>
        </dependencies>
      </plugin>

      <!-- Surefire：串行执行（forkCount=1, reuseForks=false），避免 mock server 状态竞争与 token 刷新干扰 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>2.22.2</version>
        <configuration>
          <forkCount>1</forkCount>
          <reuseForks>false</reuseForks>
          <!-- 全量回放单 URI 的 fixture 解析峰值较大（如 BudgetCenter/get 55MB 文件），
               给足堆避免 OOM。可被 MAVEN_OPTS 或 argLine 覆盖。 -->
          <argLine>-Xmx1g -Xms256m</argLine>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Test.groovy</include>
            <include>**/*Spec.groovy</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
